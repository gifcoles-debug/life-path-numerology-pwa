# 伺服器埠號
PORT=3000
# 正式環境請設為 production（會啟用 Secure Cookie）
NODE_ENV=development
# 資料庫與下載檔存放位置
STORAGE_DIR=./storage

# 註冊模式：approval = 註冊後待管理員審核（預設）；invite = 必須有邀請碼；closed = 關閉註冊
REGISTRATION_MODE=approval

# 第一次啟動時，若還沒有管理員，會用這組帳密建立（建立後請刪除這兩行）
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 每日排程（台北時間）：幾點跑「連結確認」與「實價登錄匯入」
DAILY_JOBS_HOUR=6
# 新聞多久抓一次（小時）
NEWS_INTERVAL_HOURS=3
# 設為 0 可關閉所有自動排程（例如在沒有對外網路的測試環境）
SCHEDULER_ENABLED=1
